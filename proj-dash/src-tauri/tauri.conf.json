{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tablero Sell Thru",
  "version": "0.1.0",
  "identifier": "com.comprasespeciales.sellthru",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5280",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Tablero Sell Thru - Compras Especiales",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
